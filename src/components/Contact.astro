---

<section id="contact" class="py-24 bg-dark-950 relative overflow-hidden">
  <div class="absolute inset-0 -z-10">
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-primary-600/5 rounded-full blur-3xl"></div>
  </div>

  <div class="section-container">
    <div class="max-w-2xl mx-auto text-center">
      <p class="section-subtitle">Get In Touch</p>
      <h2 class="section-title">Let's Work Together</h2>
      <div class="section-divider mx-auto"></div>

      <p class="text-dark-400 text-lg leading-relaxed mb-10">
        Whether you're looking to build cloud infrastructure, automate your deployments,
        or bring DevOps culture to your team — I'd love to chat. Drop me a message and
        let's explore what we can build together.
      </p>

      <a
        href="mailto:beos.espitia@gmail.com"
        class="btn-primary text-base px-8 py-3 mx-auto mb-12 glow"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
          <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
        </svg>
        Say Hello 👋
      </a>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        {
          socials.map((social) => (
            <a
              href={social.href}
              target={social.href.startsWith('mailto') ? undefined : '_blank'}
              rel={social.href.startsWith('mailto') ? undefined : 'noopener noreferrer'}
              class={`card p-4 flex flex-col items-center gap-2 text-center transition-all duration-200 ${social.color}`}
            >
              <span class={social.iconColor} set:html={social.icon} />
              <div>
                <p class="text-white text-sm font-medium">{social.name}</p>
                <p class="text-dark-500 text-xs font-mono truncate w-full">{social.handle}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

<footer class="border-t border-dark-800 py-8">
  <div class="section-container flex flex-col sm:flex-row items-center justify-between gap-4 text-dark-500 text-sm">
    <p class="font-mono">
      Built with <span class="text-primary-400">Astro</span> &amp; <span class="text-primary-400">Tailwind CSS</span>
    </p>
    <p>© {new Date().getFullYear()} Beos Becerra Espitia · Bogotá, Colombia 🇨🇴</p>
  </div>
</footer>
