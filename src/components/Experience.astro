---
const experiences = [
  {
    role: 'Cloud Consultant',
    company: 'SoftwareOne — Bogotá, Colombia',
    period: 'Jul 2024 — Jan 2025',
    type: 'Full-time',
    description:
      'Designed and implemented cloud architectures, led cloud migration projects, and delivered training sessions and packaged solutions to clients.',
    highlights: [
      'Designed and implemented cloud architectures for client solutions',
      'Led migration of virtual machines to cloud environments',
      'Conducted cloud workshops and technical training sessions',
      'Delivered packaged cloud solutions and internal OLAs',
    ],
    tags: ['AWS', 'Cloud Architecture', 'Cloud Migration', 'Workshops', 'Solutions Delivery'],
  },
  {
    role: 'Junior QA Engineer',
    company: 'Cámara de Comercio de Bogotá — Bogotá, Colombia',
    period: 'Feb 2023 — Oct 2023',
    type: 'Full-time',
    description:
      'Executed manual and performance testing to ensure system quality, collaborating with development teams to improve reliability and scalability.',
    highlights: [
      'Designed and executed test cases and test scenarios',
      'Performed manual, regression, and usability testing',
      'Conducted performance, load, and stress testing using JMeter',
      'Analyzed system performance and identified bottlenecks',
      'Collaborated with developers to validate fixes and improvements',
    ],
    tags: ['QA', 'JMeter', 'Performance Testing', 'Manual Testing', 'Regression Testing'],
  },
];
---

<section id="experience" class="py-24 bg-dark-950">
  <div class="section-container">
    <div class="mb-12">
      <p class="section-subtitle">Career Path</p>
      <h2 class="section-title">Work Experience</h2>
      <div class="section-divider"></div>
    </div>

    <div class="relative">
      <div class="absolute left-4 md:left-8 top-0 bottom-0 w-px bg-gradient-to-b from-primary-500 via-primary-500/50 to-transparent hidden sm:block"></div>

      <div class="space-y-8">
        {
          experiences.map((exp, index) => (
            <div class="relative sm:pl-20">
              <div class="hidden sm:flex absolute left-4 md:left-8 -translate-x-1/2 w-8 h-8 rounded-full bg-dark-900 border-2 border-primary-500 items-center justify-center text-primary-400 font-mono text-xs font-bold z-10">
                {index + 1}
              </div>

              <div class="card group">
                <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 mb-4">
                  <div>
                    <h3 class="text-xl font-bold text-white group-hover:text-primary-300 transition-colors">
                      {exp.role}
                    </h3>
                    <p class="text-primary-400 font-medium mt-0.5">{exp.company}</p>
                  </div>
                  <div class="flex flex-row sm:flex-col items-start sm:items-end gap-2 sm:gap-1 shrink-0">
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-primary-500/10 text-primary-300 text-xs font-mono rounded-full border border-primary-500/20">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd" />
                      </svg>
                      {exp.period}
                    </span>
                    <span class="inline-flex items-center px-2.5 py-0.5 bg-dark-700 text-dark-300 text-xs rounded-full border border-dark-600">
                      {exp.type}
                    </span>
                  </div>
                </div>

                <p class="text-dark-400 text-sm leading-relaxed mb-4">{exp.description}</p>

                <ul class="space-y-2 mb-5">
                  {exp.highlights.map((point) => (
                    <li class="flex items-start gap-2 text-sm text-dark-300">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary-500 mt-0.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                      </svg>
                      {point}
                    </li>
                  ))}
                </ul>

                <div class="flex flex-wrap gap-2">
                  {exp.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
