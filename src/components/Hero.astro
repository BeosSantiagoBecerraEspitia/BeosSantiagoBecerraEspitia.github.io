---
const skills = [
  'AWS', 'GCP', 'Azure', 'Kubernetes', 'Docker', 'Terraform',
  'CI/CD', 'Python', 'Go', 'Linux', 'Ansible', 'Jenkins',
];
---

<section
  id="about"
  class="relative min-h-screen flex items-center pt-16 overflow-hidden"
>
  <div class="absolute inset-0 -z-10">
    <div class="absolute top-1/4 -left-32 w-96 h-96 bg-primary-600/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-1/4 -right-32 w-96 h-96 bg-primary-800/10 rounded-full blur-3xl"></div>
    <div
      class="absolute inset-0 opacity-[0.03]"
      style="background-image: radial-gradient(circle, #3b82f6 1px, transparent 1px); background-size: 40px 40px;"
    ></div>
  </div>

  <div class="section-container py-20 w-full">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div class="animate-fade-in">
        <p class="section-subtitle">Hello, world! 👋</p>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white leading-tight mb-4">
          Beos Becerra
          <span class="gradient-text block">Espitia</span>
        </h1>

        <h2 class="text-xl sm:text-2xl text-dark-300 font-medium mb-6">
          Systems Engineer &amp; <span class="text-primary-400">Cloud / DevOps</span> Specialist
        </h2>

        <p class="text-dark-400 text-base sm:text-lg leading-relaxed mb-8 max-w-lg">
          Passionate about building reliable, scalable cloud infrastructure and
          automating everything that can be automated. Based in
          <span class="text-dark-200">Bogotá, Colombia</span> 🇨🇴 — helping teams
          ship faster with DevOps culture and modern tooling.
        </p>

        <div class="flex flex-wrap gap-3 mb-10">
          <a href="#projects" class="btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M3 4a1 1 0 011-1h4a1 1 0 010 2H6.414l2.293 2.293a1 1 0 01-1.414 1.414L5 6.414V8a1 1 0 01-2 0V4zm9 1a1 1 0 010-2h4a1 1 0 011 1v4a1 1 0 01-2 0V6.414l-2.293 2.293a1 1 0 11-1.414-1.414L13.586 5H12zm-9 7a1 1 0 012 0v1.586l2.293-2.293a1 1 0 011.414 1.414L6.414 15H8a1 1 0 010 2H4a1 1 0 01-1-1v-4zm13-1a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 010-2h1.586l-2.293-2.293a1 1 0 011.414-1.414L17 13.586V12a1 1 0 011-1z" clip-rule="evenodd" />
            </svg>
            View Projects
          </a>
          <a
            href="https://linkedin.com/in/beos-becerra"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            LinkedIn
          </a>
          <a
            href="https://github.com/beos-becerra"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
            </svg>
            GitHub
          </a>
        </div>

        <div class="flex flex-wrap gap-2">
          {skills.map((skill) => (
            <span class="tag">{skill}</span>
          ))}
        </div>
      </div>

      <div class="hidden lg:flex justify-center items-center animate-slide-up">
        <div class="relative">
          <div class="w-72 h-72 rounded-3xl bg-gradient-to-br from-primary-600/20 to-primary-800/10 border border-primary-500/20 flex items-center justify-center glow">
            <div class="text-center">
              <div class="w-32 h-32 rounded-2xl bg-gradient-to-br from-primary-500 to-primary-700 flex items-center justify-center mx-auto mb-4 shadow-lg shadow-primary-500/30">
                <span class="text-5xl font-bold text-white font-mono">B</span>
              </div>
              <p class="text-dark-300 text-sm font-mono">@beos-becerra</p>
              <p class="text-dark-500 text-xs mt-1">Bogotá, Colombia 🇨🇴</p>
            </div>
          </div>

          <div class="absolute -top-4 -right-4 card py-3 px-4 text-xs">
            <div class="flex items-center gap-2">
              <div class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></div>
              <span class="text-dark-300 font-mono">Available for hire</span>
            </div>
          </div>

          <div class="absolute -bottom-4 -left-4 card py-3 px-4 text-xs">
            <div class="flex items-center gap-2">
              <span class="text-2xl">☁️</span>
              <div>
                <p class="text-white font-medium">Cloud & DevOps</p>
                <p class="text-dark-400 font-mono">4+ years exp.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-16 pt-16 border-t border-dark-800">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-8">
        {[
          { value: '4+', label: 'Years Experience' },
          { value: '20+', label: 'Projects Delivered' },
          { value: '3', label: 'Cloud Platforms' },
          { value: '∞', label: 'Pipelines Automated' },
        ].map((stat) => (
          <div class="text-center">
            <p class="text-3xl sm:text-4xl font-bold gradient-text mb-1">{stat.value}</p>
            <p class="text-dark-400 text-sm">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
